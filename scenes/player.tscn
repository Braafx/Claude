[gd_scene load_steps=4 format=3 uid="uid://bpfmwsn1x23ky"]

; ── External resources ────────────────────────────────────────────────────────
; The GDScript that drives movement and jumping.
[ext_resource type="Script" uid="uid://c8vf4j2dk3p7m" path="res://scripts/player.gd" id="1_player"]

; ── Sub-resources (geometry / shapes defined inline) ─────────────────────────

; Capsule collision volume: radius 0.4 m, total height 1.8 m.
; Centre is placed at the capsule's midpoint, so offset the node by +0.9 Y
; so the bottom of the shape sits exactly at the CharacterBody3D origin (feet).
[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_1"]
radius = 0.4
height = 1.8

; Matching visual capsule mesh used as a stand-in until real art is added.
[sub_resource type="CapsuleMesh" id="CapsuleMesh_1"]
radius = 0.4
height = 1.8

; ── Scene tree ────────────────────────────────────────────────────────────────

; Root: CharacterBody3D handles physics-based movement via move_and_slide().
[node name="Player" type="CharacterBody3D"]
script = ExtResource("1_player")

; CollisionShape3D: tells the physics engine the player's solid volume.
; Shifted +0.9 on Y so the capsule bottom aligns with the node origin (feet).
[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_1")

; MeshInstance3D: placeholder visual — swap this out for your actual model.
; Shares the same Y offset as the collision shape so mesh and hitbox align.
[node name="MeshInstance3D" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
mesh = SubResource("CapsuleMesh_1")
